{
  "name": "ue5-runtests",
  "version": "1.0.0",
  "description": "GitHub Action for running Unreal Engine 5 tests on self-hosted runners",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "unreal-engine",
    "ue5",
    "testing",
    "github-action"
  ],
  "author": "Fork-on-the-Table-Collective",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@actions/core": "^1.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/ncc": "^0.38.3",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  }
}
